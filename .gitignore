# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Local LAN sync server's own persisted state (users/sessions/synced keys) —
# regenerated on first boot from src/data/*.json, never committed.
server/data/*
!server/data/.gitkeep

# Uploaded images (originals + compressed variants) — live only on this
# server's own disk, never committed.
server/uploads/*
!server/uploads/.gitkeep

# Disposable, re-fetchable disk cache of news article images (server/newsImageCache.ts) — never committed, not backed up either (see that file's own doc comment).
server/news-image-cache/*
!server/news-image-cache/.gitkeep

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Inno Setup installer build: compiled output and the third-party Node.js/
# Ollama installers the developer downloads and drops in installer/ before
# compiling (see adhdisplay.iss's own header comment) - both are fetched
# fresh by build-installer.yml when building via CI instead.
installer/Output
installer/node-lts-x64.msi
installer/OllamaSetup.exe

# Expo CLI's own cache directory (adhdisplay-companion/), created by
# `expo start`/`expo export`.
.expo

# Pane-resize-stutter diagnostic tooling's own captured output (traces, parsed JSON, report.md) — see
# diagnostics/pane-resize-stutter/README.md. The tooling itself is committed; only its results aren't.
diagnostics/pane-resize-stutter/results/*
!diagnostics/pane-resize-stutter/results/.gitkeep

# Timestamped backups seedClient.ts makes of server/data/*.json before its first write — throwaway
# safety copies, not meant to be committed.
server/data/*.diagbak
