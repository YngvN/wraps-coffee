{
  "expo": {
    "name": "ADHDisplay Companion",
    "slug": "adhdisplay-companion",
    "version": "0.2.39",
    "orientation": "landscape",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "splash": {
      "backgroundColor": "#111111"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "no.adhdisplay.companion",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "package": "no.adhdisplay.companion",
      "backgroundColor": "#111111",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#111111"
      },
      "versionCode": 237,
      "permissions": [
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE",
        "CHANGE_WIFI_MULTICAST_STATE"
      ]
    },
    "plugins": [
      "./plugins/withBootLaunch.js",
      "./plugins/withLeanbackManifest.js",
      "./plugins/withReleaseSigning.js",
      "./plugins/withDeviceAdmin.js",
      "./plugins/withPackageInstaller.js",
      "./plugins/withLockTask.js",
      "./plugins/withKeyEventBridge.js",
      "expo-asset",
      "expo-updates",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_ERROR_RECOVERY",
      "url": "http://localhost:4000/updates/manifest",
      "codeSigningCertificate": "./codeSigning/certificate.pem",
      "codeSigningMetadata": {
        "keyid": "main",
        "alg": "rsa-v1_5-sha256"
      },
      "disableAntiBrickingMeasures": true
    }
  }
}
